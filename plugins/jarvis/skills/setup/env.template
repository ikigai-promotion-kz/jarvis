# Ключи сервисов для JARVIS. Вписывайте значение после знака =, без кавычек и пробелов.
# Этот файл не уходит в git (он в .gitignore) и не показывается в чате.

# Firecrawl — снимает сайты конкурентов целиком. Ключ: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Exa — поиск. Работает и без ключа, ключ поднимает лимиты. https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Context7 — документация сервисов. Работает и без ключа. https://context7.com/dashboard
CONTEXT7_API_KEY=

# fal.ai — картинки и видео. https://fal.ai/dashboard/keys
FAL_KEY=

# OpenAI — расшифровка аудио, картинки GPT. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Telegram — свой бот и отчёты в Telegram. Токен у @BotFather, номер чата у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Apify — сбор данных из Instagram и других сайтов. https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Ключ НЕ нужен: Higgsfield, GitHub, Vercel, Gmail / Календарь / Диск — они подключаются входом через браузер.
